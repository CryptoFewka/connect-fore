{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Infrastructure identity, not branding: renaming this deploys a *new*
  // Worker at a new URL, orphaning the old one and breaking both the
  // Cloudflare Builds connection and every challenge link already shared.
  "name": "connect-fore",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "observability": { "enabled": true }
}
