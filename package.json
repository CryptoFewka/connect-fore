{
  "name": "fore-golf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fore! - NES-style 3D golf meets four in a row",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:worker": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint .",
    "test": "bun test",
    "build:app": "vite build --mode app",
    "cap:sync": "bun run build:app && cap sync",
    "cap:ios": "bun run cap:sync && cap open ios",
    "cap:android": "bun run cap:sync && cap open android",
    "build:web": "vite build"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/three": "^0.186.0",
    "eslint": "^10.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "wrangler": "^4.131.1"
  }
}
