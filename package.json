{
  "name": "connect-fore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Connect Fore! - NES-style 3D golf meets Connect Four",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:worker": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint .",
    "test": "bun test"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250906.0",
    "@eslint/js": "^9.35.0",
    "@types/bun": "^1.2.21",
    "@types/three": "^0.180.0",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "wrangler": "^4.34.0"
  }
}
